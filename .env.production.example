# Environment Variables Template for Dashboard (Netlify)
# Copy these to Netlify: Site settings → Environment variables

# Supabase Configuration
NG_APP_SUPABASE_URL=https://your-project.supabase.co
NG_APP_SUPABASE_ANON_KEY=your-anon-key-here

# Backend API URLs (opcional si también usas Laravel)
NG_APP_API_URL=https://api.domusone.com.co/api
NG_APP_LARAVEL_API_URL=https://domusone.com.co/api

# Site Configuration
NG_APP_SITE_URL=https://admin.domusone.com.co
NG_APP_ENVIRONMENT=production

# Dashboard Configuration
NG_APP_DASHBOARD_TITLE=Domus One Admin
